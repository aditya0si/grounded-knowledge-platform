# Grounded Knowledge Platform — environment template
#
# Copy to `.env` and fill in. Every value below has a working development
# default in src/gkp/core/config.py EXCEPT the provider credentials, which
# have no defaults by design: the test suite must pass with none of them set.

# ---------------------------------------------------------------- runtime
GKP_ENV=dev
GKP_DEBUG=false

# ---------------------------------------------------------------- infra
# Ports are deliberately offset (5434/6381) so this stack can run alongside
# other local Postgres/Redis containers without a collision.
GKP_DATABASE_URL=postgresql+asyncpg://gkp:gkp@localhost:5434/gkp
GKP_REDIS_URL=redis://localhost:6381/0

# ---------------------------------------------------------------- retrieval
GKP_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
GKP_EMBEDDING_DIM=768
GKP_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------- generation
# Optional. Leave unset to run retrieval-only evaluation (M1/M2 need no LLM).
GKP_LLM_PROVIDER=
GKP_LLM_BASE_URL=
GKP_LLM_MODEL=
GKP_LLM_API_KEY=
